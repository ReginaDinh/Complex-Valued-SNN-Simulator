  ```
- **Thay bằng:**

  (a) Tạo file `src/utils/random.ts`:
  ```ts
  // Deterministic, high-quality PRNG utilities (no Math.random) for reproducible noise

  // Mulberry32: 32-bit state PRNG returning floats in [0, 1)
  export function mulberry32(seed: number): () => number {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  // Combine integer parts into one well-mixed 32-bit seed (FNV-1a + murmur3 finalizer)
  export function hashSeed(...parts: number[]): number {
    let h = 0x811c9dc5;
    for (const p of parts) {
      h = Math.imul(h ^ (p | 0), 0x01000193);
    }
    h ^= h >>> 16;
    h = Math.imul(h, 0x85ebca6b);
    h ^= h >>> 13;
    h = Math.imul(h, 0xc2b2ae35);
    h ^= h >>> 16;
    return h >>> 0;
  }

  // Standard normal sample N(0, 1) via Box-Muller, fully determined by seed
  export function seededGaussian(seed: number): number {
    const rng = mulberry32(seed);
    const u1 = Math.max(1e-12, rng());
    const u2 = rng();
    return Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);
  }
  ```
  (b) `VisionSNN.tsx`: xóa hàm `seededGaussian` cục bộ (dòng 71-78) và import:
  ```ts
  import { mulberry32, hashSeed, seededGaussian } from '../utils/random';
  ```
  Nhiễu ghi trọng số (dòng 186-187), dùng các "kênh" 1 và 2 tách biệt:
  ```ts
            const nRe = seededGaussian(hashSeed(noiseSeed, 1, c, idx));
            const nIm = seededGaussian(hashSeed(noiseSeed, 2, c, idx));
  ```
  Jitter pha đầu vào (dòng 243). Không phụ thuộc `o`, vì cả 4 neuron nhận cùng một input:
  ```ts
